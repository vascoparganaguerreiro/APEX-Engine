# Copy to .env.local for local work. On Vercel add the same two names in Project > Settings > Environment Variables.
# Use the PUBLISHABLE (anon) key only. Never put a secret / service_role key here.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_PUBLISHABLE_KEY

# --- Server only (NO "NEXT_PUBLIC_" prefix, never exposed to the browser) ---
# Google AI Studio key used by /api/summarize
GEMINI_API_KEY=YOUR_GEMINI_KEY
# optional: force a model
# GEMINI_MODEL=
# AI summaries share the durable Coach limit below (COACH_HOURLY_LIMIT / COACH_DAILY_LIMIT); SUMMARY_DAILY_LIMIT is no longer used.

# Intervals.icu integration (server only, never NEXT_PUBLIC_).
# Encryption key: 32 random bytes, base64. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Key rotation: add INTERVALS_ENCRYPTION_KEY_V2=... and set INTERVALS_ENCRYPTION_ACTIVE_VERSION=2; keep the old
# key until every stored key has been re-encrypted (it happens automatically on next sync).
INTERVALS_ENCRYPTION_KEY=
# INTERVALS_ENCRYPTION_ACTIVE_VERSION=1
# Supabase service_role key: server only, never commit it.
SUPABASE_SERVICE_ROLE_KEY=
# Biomarker report extraction: max readings per user per rolling hour (default 10, allowed 1-1000)
# EXTRACT_HOURLY_LIMIT=10

# Universal Connect (server only, never NEXT_PUBLIC_). Leave empty until the app is registered with the provider; the Connectivity
# Centre then shows "server set-up needed". Tokens are encrypted with the INTERVALS_ENCRYPTION_KEY(_V<n>) keys above.
# WHOOP: register at the WHOOP Developer Dashboard; redirect URI = https://<host>/api/integrations/whoop/callback
# WHOOP_CLIENT_ID=
# WHOOP_CLIENT_SECRET=
# WHOOP_REDIRECT_URI=
# Intervals.icu OAuth (optional, needs an approved app from https://intervals.icu/oauth/apply; the API key keeps working without it)
# INTERVALS_CLIENT_ID=
# INTERVALS_CLIENT_SECRET=
# INTERVALS_REDIRECT_URI=

# APEX Coach (server only): requests per user per rolling hour / per day (defaults 30 / 150). Separate from the report-extraction limit.
# COACH_HOURLY_LIMIT=30
# COACH_DAILY_LIMIT=150
