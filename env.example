# Copy to .env.local for local work. On Vercel add the same two names in Project > Settings > Environment Variables.
# Use the PUBLISHABLE (anon) key only. Never put a secret / service_role key here.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_PUBLISHABLE_KEY

# --- Server only (NO "NEXT_PUBLIC_" prefix, never exposed to the browser) ---
# Google AI Studio key used by /api/summarize
GEMINI_API_KEY=YOUR_GEMINI_KEY
# optional: force a model, and cap summaries per user per day (default 30)
# GEMINI_MODEL=
# SUMMARY_DAILY_LIMIT=30
# optional: cap automatic lab report readings per user per day (default 10)
# REPORT_DAILY_LIMIT=10
# Daily AI limits reset at 00:00 UTC and are counted server-side (09_ai_usage.sql, needs SUPABASE_SERVICE_ROLE_KEY).
# A missing, negative or non-numeric value falls back to the default; 0 turns the feature off (it never means unlimited).
