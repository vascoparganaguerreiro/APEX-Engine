# Copy to .streamlit/secrets.toml (local) or paste in: Streamlit app > Settings > Secrets.
# NEVER commit the real secrets.toml to GitHub.
[supabase]
url = "https://YOUR-PROJECT-REF.supabase.co"
anon_key = "YOUR_PUBLISHABLE_OR_ANON_KEY"

[gemini]
api_key = "YOUR_GEMINI_API_KEY"
# optional:
# model = "gemini-2.5-flash"
# daily_limit = 20      # questions per user per day
